<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>

        <!--
            PINNED, BECAUSE THE SUITE MUST NOT DEPEND ON A DEVELOPER'S .env.

            Task 31b made two-factor enforcement an environment decision and
            the client promptly set AUTH_REQUIRE_TWO_FACTOR=false in their own
            .env — which is exactly what it is for. The suite inherited it, and
            four tests that assert an admin without a second factor is refused
            went green-to-red on a file that is not in version control.

            That was a defect in 31b: a test whose result depends on an
            untracked local file is not a test. Pinned to the SECURE value, so
            the suite proves the production behaviour; the tests that need
            enforcement off set config('auth.require_two_factor') themselves
            and say so.
        -->
        <env name="AUTH_REQUIRE_TWO_FACTOR" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3308"/>
        <env name="DB_DATABASE" value="photographer_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
